--// FOV RING
local FOVring = Drawing.new("Circle")
FOVring.Visible = true; FOVring.Thickness = 1; FOVring.Radius = fov; FOVring.Transparency = 0.8; FOVring.Color = Color3.fromRGB(255, 128, 128)

--// HÀM KIỂM TRA VẬT CẢN (RAYCAST)
local function isVisible(part)
    if not part then return false end
    local origin = Camera.CFrame.Position
    local result = workspace:Raycast(origin, (part.Position - origin), _rayparams)
    return result == nil 
end

--// LOGIC TÌM MỤC TIÊU BAN ĐẦU
local function getClosestVisible()
    local target, bestPart, minPadding = nil, nil, fov
    local screenCenter = Camera.ViewportSize / 2
    local players = Players:GetPlayers()

    local partsToScan
    if wallCheck then
        -- BẬT WALL CHECK: Quét tất cả các bộ phận
        partsToScan = {
            "Head", "HumanoidRootPart", "UpperTorso", "LowerTorso", "Torso",
            "RightUpperArm", "LeftUpperArm", "RightLowerArm", "LeftLowerArm",
            "RightUpperLeg", "LeftUpperLeg", "RightLowerLeg", "LeftLowerLeg"
        }
    else
        -- TẮT WALL CHECK: Chỉ quét các phần thân chính
        partsToScan = {
            "Head", "HumanoidRootPart", "UpperTorso", "LowerTorso", "Torso",
            "RightUpperArm", "LeftUpperArm"
        }
    end

    for i = 1, #players do
        local v = players[i]
        if v == LocalPlayer or whitelisted[v.Name] or (v.Team and teamWhitelisted[v.Team.Name]) then continue end
        local char = v.Character
        if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
            if teamCheck and v.Team == LocalPlayer.Team then continue end

            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist3D = (hrp.Position - Camera.CFrame.Position).Magnitude
                if dist3D > maxDistance then continue end
            end

            for _, pName in ipairs(partsToScan) do
                local part = char:FindFirstChild(pName)
                if part then
                    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                        if dist < minPadding then
                            -- Nếu bật Wall Check thì phải kiểm tra có bị chắn không trước khi khóa mục tiêu mới
                            if not wallCheck or isVisible(part) then
                                minPadding, target, bestPart = dist, v, pName
                            end
                        end
                    end
                end
            end
        end
    end
    return target, bestPart
end

--// VÒNG LẶP KHÓA TÂM CHUẨN XÁC
local currentTarget, currentPart
RunService.RenderStepped:Connect(function()
    if not aimbotEnabled then FOVring.Visible = false; currentTarget = nil; return end
    FOVring.Visible = true; FOVring.Position = Camera.ViewportSize / 2
    
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then

        -- KIỂM TRA ĐỊCH ĐANG KHÓA
        if currentTarget and currentTarget.Character and currentTarget.Character:FindFirstChild("Humanoid") and currentTarget.Character.Humanoid.Health > 0 then
            local p = currentTarget.Character:FindFirstChild(currentPart)
            if not p then
                currentTarget = nil 
            else
                -- LOGIC ĐÃ SỬA Ở ĐÂY: 
                -- Nếu bật Wall Check mà mục tiêu chạy núp sau TƯỜNG -> NHẢ TÂM NGAY LẬP TỨC
                -- (Không lo bị nhả khi người chơi khác đi ngang qua vì danh sách Raycast đã tự loại trừ tất cả các người chơi)
                if wallCheck and not isVisible(p) then
                    currentTarget = nil
                end
            end
        else
            currentTarget = nil 
        end

        -- KHÓA ĐỊCH MỚI
        if not currentTarget then 
            currentTarget, currentPart = getClosestVisible() 
        end

        -- DÍ TÂM LIÊN TỤC
        if currentTarget and currentTarget.Character and currentPart then
            local part = currentTarget.Character:FindFirstChild(currentPart)
            if part then
                local hrp = currentTarget.Character:FindFirstChild("HumanoidRootPart")
                local velocity = (hrp and hrp.Velocity) or Vector3.zero
                local targetPos = part.Position + (velocity * predictionFactor)
                
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetPos), smoothing)
                FOVring.Color = Color3.fromRGB(0, 255, 0) -- Đã fix lỗi biến green không tồn tại ở đây
            end
        else
            FOVring.Color = Color3.fromRGB(255, 128, 128)
        end
    else
        currentTarget = nil
        FOVring.Color = Color3.fromRGB(255, 128, 128)
    end
end)
