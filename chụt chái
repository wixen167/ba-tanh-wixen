--// TỐI ƯU RAYCAST PARAMS (Sử dụng Event-driven)
local _rayparams = RaycastParams.new()
_rayparams.FilterType = Enum.RaycastFilterType.Exclude
_rayparams.IgnoreWater = true

local function updateIgnoreList()
    local ignoreList = {Camera}
    if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end
    
    local allPlayers = Players:GetPlayers()
    for i = 1, #allPlayers do
        local char = allPlayers[i].Character
        if char then table.insert(ignoreList, char) end
    end
    _rayparams.FilterDescendantsInstances = ignoreList
end

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(updateIgnoreList)
    p.CharacterRemoving:Connect(updateIgnoreList)
end)
Players.PlayerRemoving:Connect(updateIgnoreList)
updateIgnoreList()

