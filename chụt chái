local function UpdateFriendList()
    for _, child in ipairs(Scroll:GetChildren()) do 
        if child:IsA("Frame") or child:IsA("TextButton") then child:Destroy() end 
    end
    
    local allTeams = Teams:GetTeams()
    
    local function CreatePlayerBtn(p, parent, isNested)
        local btn = Instance.new("TextButton", parent)
        btn.Size = UDim2.new(1, isNested and -20 or 0, 0, 25)
        if isNested then btn.Position = UDim2.new(0, 20, 0, 0) end
        btn.BackgroundColor3 = whitelisted[p.Name] and Color3.fromRGB(50, 150, 50) or Color3.fromRGB(45, 45, 46)
        btn.Text = " " .. p.DisplayName
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.Font = Enum.Font.SourceSans
        btn.TextSize = 14
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.BorderSizePixel = 0
        
        btn.MouseButton1Click:Connect(function() 
            whitelisted[p.Name] = not whitelisted[p.Name]
            btn.BackgroundColor3 = whitelisted[p.Name] and Color3.fromRGB(50, 150, 50) or Color3.fromRGB(45, 45, 46)
        end)
    end
    
    if #allTeams > 0 then
        for _, team in ipairs(allTeams) do
            local tFrame = Instance.new("Frame", Scroll); tFrame.Size = UDim2.new(1, 0, 0, 25); tFrame.BackgroundTransparency = 1
            local tBtn = Instance.new("TextButton", tFrame); tBtn.Size = UDim2.new(1, -25, 1, 0); tBtn.Position = UDim2.new(0, 25, 0, 0); tBtn.BackgroundColor3 = teamWhitelisted[team.Name] and Color3.fromRGB(50, 100, 150) or Color3.fromRGB(55, 55, 56); tBtn.Text = " " .. team.Name; tBtn.TextColor3 = team.TeamColor.Color; tBtn.Font = Enum.Font.SourceSansBold; tBtn.TextSize = 14; tBtn.TextXAlignment = Enum.TextXAlignment.Left; tBtn.BorderSizePixel = 0
            local arrow = Instance.new("TextButton", tFrame); arrow.Size = UDim2.new(0, 25, 1, 0); arrow.BackgroundColor3 = Color3.fromRGB(40, 40, 41); arrow.Text = collapsedTeams[team.Name] and ">" or "v"; arrow.TextColor3 = Color3.new(1, 1, 1); arrow.BorderSizePixel = 0
            
            tBtn.MouseButton1Click:Connect(function() 
                teamWhitelisted[team.Name] = not teamWhitelisted[team.Name]
                tBtn.BackgroundColor3 = teamWhitelisted[team.Name] and Color3.fromRGB(50, 100, 150) or Color3.fromRGB(55, 55, 56)
            end)
            
            arrow.MouseButton1Click:Connect(function() 
                collapsedTeams[team.Name] = not collapsedTeams[team.Name]
                UpdateFriendList() 
            end)
            
            if not collapsedTeams[team.Name] then 
                for _, p in ipairs(Players:GetPlayers()) do 
                    if p ~= LocalPlayer and p.Team == team then CreatePlayerBtn(p, Scroll, true) end 
                end 
            end
        end
    else
        for _, p in ipairs(Players:GetPlayers()) do 
            if p ~= LocalPlayer then CreatePlayerBtn(p, Scroll, false) end 
        end
    end
end

UpdateFriendList()
