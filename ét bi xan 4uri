--// HÀM KIỂM TRA TRUY NÃ
local function checkWanted(plr)
    local wanted = false
    pcall(function()
        local attr = plr:GetAttribute("Wanted") or plr:GetAttribute("Stars") or plr:GetAttribute("WantedLevel") or plr:GetAttribute("Bounty")
        if attr and tonumber(attr) > 0 then wanted = true return end
        
        local ls = plr:FindFirstChild("leaderstats")
        if ls then
            local lsStars = ls:FindFirstChild("Stars") or ls:FindFirstChild("Wanted") or ls:FindFirstChild("Bounty") or ls:FindFirstChild("WantedLevel")
            if lsStars and tonumber(lsStars.Value) > 0 then wanted = true end
        end
    end)
    return wanted
end

--// ESP CORE LOGIC
local function createESP(plr)
    -- TỐI ƯU HÓA: Tạo Highlight 1 lần duy nhất cho mỗi player, giấu trong screenGui
    local hl = Instance.new("Highlight", screenGui)
    hl.Name = "WSS_FastHighlight"
    hl.OutlineTransparency = 0.5
    hl.FillTransparency = 0.5
    hl.Enabled = false

    _G.WSS_Drawings[plr] = {
        Outline = Drawing.new("Square"),
        Health = Drawing.new("Line"),
        Name = Drawing.new("Text"),
        Tracer = Drawing.new("Line"),
        WantedText = Drawing.new("Text"), -- CHỮ TRUY NÃ
        Highlight = hl -- Lưu vào cache
    }
    local d = _G.WSS_Drawings[plr]
    d.Outline.Thickness = 1
    d.Health.Thickness = 2
    
    d.Name.Center = true
    d.Name.Outline = true
    d.Name.OutlineColor = Color3.new(0, 0, 0)
    d.Name.Size = 11
    d.Name.Font = 1
    
    d.Tracer.Thickness = 1
    d.Tracer.Transparency = 0.7
    
    -- Config chữ Truy Nã
    d.WantedText.Center = true
    d.WantedText.Outline = true
    d.WantedText.OutlineColor = Color3.new(0, 0, 0)
    d.WantedText.Size = 8
    d.WantedText.Font = 1
    d.WantedText.Color = Color3.fromRGB(255, 170, 0) -- Màu cam vàng giống màu ngôi sao
    d.WantedText.Text = "WANTED"
end

for _, p in pairs(Players:GetPlayers()) do if p ~= LocalPlayer then createESP(p) end end
Players.PlayerAdded:Connect(function(p) if p ~= LocalPlayer then createESP(p) end end)
Players.PlayerRemoving:Connect(function(p) 
