        _G.WSS_Drawings[p] = nil 
    end 
end)

--// RENDER LOOP
RunService.RenderStepped:Connect(function()
    local camPos = camera.CFrame.Position
    local myTeamColor = LocalPlayer.TeamColor -- Cache màu team để không gọi lại nghìn lần

    for plr, box in pairs(_G.WSS_Drawings) do
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        
        if espEnabled and char and hrp and hum and hum.Health > 0 then
            local dist = (hrp.Position - camPos).Magnitude
            if dist < _G.MaxDistance then
                local pos, vis = camera:WorldToViewportPoint(hrp.Position)
                
                -- TỐI ƯU HIGHLIGHT: Chỉ update Adornee, không tạo rác
                if showHighlight then
                    box.Highlight.Adornee = char
                    box.Highlight.FillColor = (_G.UseTeamColor and plr.TeamColor.Color) or (plr.TeamColor == myTeamColor and _G.FriendColor or _G.EnemyColor)
                    box.Highlight.Enabled = true
                else
                    box.Highlight.Enabled = false
                end

                if vis then
                    local color = (_G.UseTeamColor and plr.TeamColor.Color) or (plr.TeamColor == myTeamColor and _G.FriendColor or _G.EnemyColor)
                    local scale = 1 / (dist * math.tan(math.rad(camera.FieldOfView / 2)) * 2) * 1000
                    local w, h = 4 * scale, 6 * scale

                    -- Khung Box
                    box.Outline.Visible = showBox
                    if showBox then
                        box.Outline.Size = Vector2.new(w, h)
                        box.Outline.Position = Vector2.new(pos.X - w/2, pos.Y - h/2)
                        box.Outline.Color = color
                    end

                    -- Tên người chơi
                    box.Name.Visible = showName
                    if showName then
                        box.Name.Position = Vector2.new(pos.X, pos.Y - h/2 - 20)
                        box.Name.Text = plr.DisplayName .. " ["..math.floor(dist).."m]"
                        box.Name.Color = color
                    end

                    -- Thanh máu
                    box.Health.Visible = showHealthbar
                    if showHealthbar then
                        local hpP = hum.Health / hum.MaxHealth
                        box.Health.From = Vector2.new(pos.X - w/2 - 5, pos.Y + h/2)
                        box.Health.To = Vector2.new(pos.X - w/2 - 5, pos.Y + h/2 - (h * hpP))
                        box.Health.Color = Color3.fromHSV(hpP * 0.3, 1, 1)
                    end

                    -- Đường kẻ Tracer
                    box.Tracer.Visible = showTracer
                    if showTracer then
                        box.Tracer.From = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y)
                        box.Tracer.To = Vector2.new(pos.X, pos.Y + h/2)
                        box.Tracer.Color = color
                    end
                    
                    -- Chữ TRUY NÃ ở dưới
                    if checkWanted(plr) then
                        box.WantedText.Visible = true
                        box.WantedText.Position = Vector2.new(pos.X, pos.Y + h/2 + 5)
                    else
                        box.WantedText.Visible = false
                    end
                    
                    continue
                end
            end
        end
        -- Ẩn hết nếu ở xa hoặc chết/tắt ESP
        box.Outline.Visible = false
        box.Health.Visible = false
        box.Name.Visible = false
        box.Tracer.Visible = false
        box.WantedText.Visible = false
        box.Highlight.Enabled = false
    end
end)
