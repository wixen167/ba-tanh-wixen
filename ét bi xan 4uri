-- Ping Logic
local function PingPlayer(targetPlr)
    local dot = Drawing.new("Circle")
    dot.Filled = true
    dot.Radius = 20
    dot.Color = Color3.new(1, 1, 0)
    dot.Transparency = 1
    local conn
    local start = tick()
    conn = RunService.RenderStepped:Connect(function()
        if tick() - start > 3 or not targetPlr.Character then dot:Remove(); conn:Disconnect() return end
        local hrp = targetPlr.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local pos, vis = camera:WorldToViewportPoint(hrp.Position)
            dot.Visible = vis
            dot.Position = Vector2.new(pos.X, pos.Y)
            dot.Radius = 10 + (math.sin(tick() * 25) * 10)
        else dot.Visible = false end
    end)
end

-- Refresh Player List
local function updatePlayerList()
    for _, v in pairs(scrollList:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    local filter = searchBox.Text:lower()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if p.Name:lower():find(filter) or p.DisplayName:lower():find(filter) then
                local b = Instance.new("TextButton", scrollList)
                b.Size = UDim2.new(1, 0, 0, 35)
                b.BackgroundColor3 = Color3.fromRGB(40,40,40)
                b.TextColor3 = Color3.new(1,1,1)
                b.Font = Enum.Font.Gotham
                b.TextSize = 11
                b.Text = p.DisplayName .. " (@" .. p.Name .. ")"
                Instance.new("UICorner", b)
                b.MouseButton1Click:Connect(function() PingPlayer(p); playerListFrame.Visible = false end)
            end
        end
    end
end

